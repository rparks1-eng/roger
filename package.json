{
  "name": "atlas-reader-class-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:python": "python3 -B -m unittest discover -s tests -p 'test_*.py'",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:workflow": "npm run test:map && node scripts/verify-workflow.mjs && npm run test:builder && npm run test:semester && npm run test:memory",
    "import:core": "node scripts/import-atlas-core.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "setup": "node scripts/setup.mjs",
    "prestart": "node scripts/quality/run.mjs static",
    "pretest": "node scripts/quality/run.mjs static",
    "check": "node scripts/quality/run.mjs all",
    "check:static": "node scripts/quality/run.mjs static",
    "format": "node scripts/quality/run.mjs format",
    "check:architecture": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "map": "node scripts/quality/map.mjs",
    "map:check": "node scripts/quality/map.mjs --check",
    "verify:gates": "node scripts/quality/test-gates.mjs",
    "test:map": "node scripts/quality/explorer-workflow.mjs",
    "test:builder": "node scripts/verify-builder.mjs",
    "test:semester": "node scripts/verify-semester-ui.mjs",
    "test:memory": "node scripts/verify-memory-ui.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  }
}
